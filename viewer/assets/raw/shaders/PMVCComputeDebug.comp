#version 450

// barycentric + triangle-index texture
layout(binding = 0) uniform sampler2DArray uBaryTex;

// Output triangle index per pixel
layout(std430, binding = 1) buffer TriOut {
    uint triOut[];
};

// Push constants
layout(push_constant) uniform Params {
    int   uNumCubemaps;
    ivec2 uFaceSize;        // (width, height)
    int   uFacesPerCubemap; // usually 6
    int   uNumTriangles;
} params;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint cubemapIdx = gl_GlobalInvocationID.x;
    if (cubemapIdx >= uint(params.uNumCubemaps))
        return;

    int width  = params.uFaceSize.x;
    int height = params.uFaceSize.y;

    uint pixelsPerFace   = uint(width * height);
    uint pixelsPerCube   = pixelsPerFace * uint(params.uFacesPerCubemap);
    uint cubeBase        = cubemapIdx * pixelsPerCube;

    for (int face = 0; face < params.uFacesPerCubemap; ++face) {
        int layer = int(cubemapIdx) * params.uFacesPerCubemap + face;
        uint faceBase = cubeBase + uint(face) * pixelsPerFace;

        for (int y = 0; y < height; ++y) {
            for (int x = 0; x < width; ++x) {

                vec4 tex = texelFetch(uBaryTex, ivec3(x, y, layer), 0);

                // SAME decode you currently use
                uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);

                uint idx =
                    faceBase +
                    uint(y * width + x);

                // Write raw decoded triangle index
                triOut[idx] = tri;
            }
        }
    }
}
