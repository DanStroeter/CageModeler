#version 450
#extension GL_EXT_shader_atomic_float : require

// PMVC weight accumulation using precomputed heat-method interior distances. Identical
// to PMVCComputeAtmoicDepth.comp except that the interior detour (interior distance
// minus Euclidean distance, zero wherever the cage is convex from the mesh vertex) of
// the hit triangle's cage vertices is barycentrically interpolated and added on top of
// the eye-space depth reconstructed from the rasterized depth. Where the cage is locally
// convex the detour vanishes and the weight reduces exactly to the Euclidean variant;
// interpolating absolute distances instead would systematically overestimate the hit
// distance mid-triangle on coarse cages. The depth peeling passes of the multi-hit
// (ring) variant work unchanged: each pass rasterizes its own depth layer.

// Rendered barycentric + triangle index image
layout(binding = 0) uniform sampler2DArray uBaryTex;

// Triangle vertex index list (3 indices per triangle)
layout(std430, binding = 1) readonly buffer VertexList {
    uint vertexList[];
};

// Output λ values (one buffer per dispatch / cubemap)
layout(std430, binding = 2) buffer LambdaOut {
    float lambda[];
};

// Output wsum (single float per dispatch / cubemap)
layout(std430, binding = 3) buffer WSumOut {
    float wsum[];
};

// Solid angle lookup (per face)
layout(binding = 4) uniform sampler2DArray uSolidAngleTex;

// Depth cubemap (no-hit / peel test and base distance of the current hit)
layout(binding = 5) uniform sampler2DArray uDepthTex;

// Interior detour table: interiorDetour[meshVertexIdx * numCageVertices + cageVertexIdx]
// holds interiorDistance - euclideanDistance (>= 0) between the two vertices.
layout(std430, binding = 6) readonly buffer InteriorDetours {
    float interiorDetour[];
};

// Push constants
layout(push_constant) uniform Params {
    ivec2 uFaceSize;        // cubemap face resolution
    int   uNumTriangles;    // number of triangles in cage mesh
    int   uNumCageVertices; // number of cage vertices (table row stride)
    int   uMeshVertexIdx;   // deformable vertex this cubemap belongs to
    float uNearPlane;       // near plane of the cubemap projection
    float uFarPlane;        // far plane of the cubemap projection
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    uint x    = gl_GlobalInvocationID.x;
    uint y    = gl_GlobalInvocationID.y;
    uint face = gl_GlobalInvocationID.z;

    if (x >= uint(params.uFaceSize.x) ||
        y >= uint(params.uFaceSize.y) ||
        face >= 6u)
    {
        return;
    }

    vec4 tex = texelFetch(uBaryTex, ivec3(x, y, face), 0);
    uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);
    if (tri >= uint(params.uNumTriangles))
        return;

    // Sample raw depth from cubemap face. 1.0 means no geometry hit (clear value).
    float depth = texelFetch(uDepthTex, ivec3(x, y, face), 0).r;
    if (depth >= 0.999999)
        return;

    uint i0 = vertexList[tri * 3 + 0];
    uint i1 = vertexList[tri * 3 + 1];
    uint i2 = vertexList[tri * 3 + 2];

    // Interior detour at the hit point: the cubemap render encodes the barycentric
    // coordinates of the hit in RGB, reuse them to interpolate the per-cage-vertex
    // detours of the hit triangle.
    uint tableBase = uint(params.uMeshVertexIdx) * uint(params.uNumCageVertices);
    float detour =
        tex.r * interiorDetour[tableBase + i0] +
        tex.g * interiorDetour[tableBase + i1] +
        tex.b * interiorDetour[tableBase + i2];

    // Reconstruct the eye-space depth of the rasterized hit from the [0, 1] perspective
    // depth, lengthen the ray by the detour (eye-space depth grows by detour * cos(theta)
    // of the texel direction) and re-encode with the same mapping.
    float nearPlane = params.uNearPlane;
    float farPlane = params.uFarPlane;
    float zEye = (farPlane * nearPlane) / (farPlane - depth * (farPlane - nearPlane));

    float u = (2.0 * (float(x) + 0.5) / float(params.uFaceSize.x)) - 1.0;
    float v = (2.0 * (float(y) + 0.5) / float(params.uFaceSize.y)) - 1.0;
    float cosTheta = inversesqrt(1.0 + u * u + v * v);
    float zEyeInterior = zEye + max(detour, 0.0) * cosTheta;

    float interiorDepth = clamp(
        (farPlane * (zEyeInterior - nearPlane)) / (zEyeInterior * (farPlane - nearPlane)),
        0.0, 1.0);

    float depthWeight = 1.0 - interiorDepth;
    float solidAngle = texelFetch(uSolidAngleTex, ivec3(x, y, face), 0).r;
    float w = solidAngle * depthWeight;
    if (w <= 0.0)
        return;

    atomicAdd(lambda[i0], tex.r * w);
    atomicAdd(lambda[i1], tex.g * w);
    atomicAdd(lambda[i2], tex.b * w);
    atomicAdd(wsum[0], w);
}
