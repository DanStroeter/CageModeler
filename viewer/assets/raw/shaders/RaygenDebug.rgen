#version 460
#extension GL_EXT_ray_tracing : require

layout(push_constant) uniform PushConstants
{
    uint vertexCount;
    uint raysPerVertex;
    uint maxHitsPerRay;
    uint padding;
} pc;

// Binding 1: one uint entry written per launched ray
layout(set = 0, binding = 1, std430) buffer HitBuffer
{
    uint rayIndices[];
} hitBuffer;

// Binding 2: atomic counter incremented for each launched ray
layout(set = 0, binding = 2, std430) buffer CounterBuffer
{
    uint atomicCounter;
} counterBuffer;

void main()
{
    const uint globalRayIndex = gl_LaunchIDEXT.x;
    const uint totalRays = pc.vertexCount * pc.raysPerVertex;

    if (globalRayIndex >= totalRays)
        return;

    hitBuffer.rayIndices[globalRayIndex] = globalRayIndex;
    atomicAdd(counterBuffer.atomicCounter, 1u);
}
