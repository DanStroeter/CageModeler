#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable

struct HitData {
    uint faceIndex;
    float barycentricU;
    float barycentricV;
    float distance;
    uint sourceVertex;
    uint rayIndex;
    uint padding[2];  // Ensure 32-byte alignment
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 0, binding = 1, std430) readonly buffer DeformableVerts {
    vec4 vertices[];  // xyz = position, w = vertex index
} deformableVerts;

layout(set = 0, binding = 2, std430) readonly buffer RayDirections {
    vec4 directions[];  // xyz = direction, w = ray index within vertex
} rayDirs;

layout(set = 0, binding = 3, std430) buffer HitBuffer {
    uint atomicCounter;
    HitData hits[];  // variable-sized array after counter
} hitBuffer;

layout(set = 0, binding = 4, std430) readonly buffer CageIndices {
    uvec3 indices[];
} cageIndices;

layout(push_constant) uniform PushConstants {
    uint vertexCount;
    uint raysPerVertex;
    uint maxHitsPerRay;
} pc;

layout(location = 0) rayPayloadEXT HitData payload;

void main()
{
    uint rayIndex = gl_LaunchIDEXT.x;
    uint globalRayIndex = gl_LaunchIDEXT.x;
    
    uint vertexIdx = globalRayIndex / pc.raysPerVertex;
    uint localRayIdx = globalRayIndex % pc.raysPerVertex;
    
    if (vertexIdx >= pc.vertexCount) {
        return;  // Out of bounds
    }
    
    // Get vertex position and ray direction
    vec3 origin = deformableVerts.vertices[vertexIdx].xyz;
    vec3 dir = rayDirs.directions[localRayIdx].xyz;
    
    // Initialize payload
    payload.faceIndex = 0xFFFFFFFF;
    payload.barycentricU = 0.0;
    payload.barycentricV = 0.0;
    payload.distance = 0.0;
    payload.sourceVertex = vertexIdx;
    payload.rayIndex = localRayIdx;
    
    traceRayEXT(
        tlas,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        0,           // sbtRecordOffset
        0,           // sbtRecordStride
        0,           // missIndex
        origin,
        0.001,       // tmin
        dir,
        10000.0,     // tmax
        0            // payload location
    );
    
    // If we got a hit, write it to the hit buffer using atomic counter
    if (payload.faceIndex != 0xFFFFFFFF) {
        uint hitIndex = atomicAdd(hitBuffer.atomicCounter, 1);
        if (hitIndex < pc.vertexCount * pc.raysPerVertex * pc.maxHitsPerRay) {
            hitBuffer.hits[hitIndex] = payload;
        }
    }
}