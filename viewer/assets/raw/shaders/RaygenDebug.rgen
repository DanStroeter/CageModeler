#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable

// Push constants matching your C++ structure
layout(push_constant) uniform PushConstants 
{
    uint vertexCount;
    uint raysPerVertex;
    uint maxHitsPerRay;
    uint padding;
} pc;

// Binding 0: Acceleration structure (not directly accessed in shader)
// This is implicitly used by traceRayEXT

// Binding 1: Deformable vertices (origins)
layout(set = 0, binding = 1, std430) readonly buffer VertexBuffer 
{
    vec4 vertices[];
} vertexBuffer;

// Binding 2: Ray directions
layout(set = 0, binding = 2, std430) readonly buffer RayDirectionBuffer 
{
    vec4 directions[];
} rayDirectionBuffer;

// Binding 3: Hit buffer with atomic counter at start
// HitBufferData = uint32_t rayIndex;
layout(set = 0, binding = 3, std430) buffer HitBuffer 
{
    uint atomicCounter;
    uint rayIndices[];  // Each entry is just a rayIndex (uint32_t)
} hitBuffer;

// Binding 4: Atomic counter (redundant since it's part of hitBuffer)

// Ray payload (minimal for this test)
layout(location = 0) rayPayloadEXT vec4 payload;

void main()
{
    // Calculate ray index from launch ID
    uint globalRayIndex = gl_LaunchIDEXT.x;
    uint totalRays = pc.vertexCount * pc.raysPerVertex;
    
    // Bounds checking
    if (globalRayIndex >= totalRays)
        return;
    
    // Calculate vertex and local ray index (optional, for debugging)
    uint vertexIdx = globalRayIndex / pc.raysPerVertex;
    uint localRayIdx = globalRayIndex % pc.raysPerVertex;
    
    // Get ray origin and direction (optional, not needed for validation)
    // vec4 origin = vertexBuffer.vertices[vertexIdx];
    // vec4 direction = rayDirectionBuffer.directions[globalRayIndex];
    
    // --- VALIDATION WRITE ---cd 
    // Atomically increment counter and get index for this hit
    uint hitIndex = atomicAdd(hitBuffer.atomicCounter, 1);
    
    // Store just the rayIndex as per HitBufferData structure
    hitBuffer.rayIndices[hitIndex] = globalRayIndex;
    
    // Optionally trace a ray (commented out for pure validation)
    /*
    // Trace ray
    traceRayEXT(TOP_LEVEL,        // acceleration structure
                gl_RayFlagsNoneEXT, // ray flags
                0xFF,              // cull mask
                0,                 // sbt record offset
                0,                 // sbt record stride
                0,                 // miss index
                origin.xyz,        // origin
                0.0,               // tmin
                direction.xyz,     // direction
                1000.0,            // tmax
                0);                // payload location
    */
}