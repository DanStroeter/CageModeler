#version 450
// barycentric + tri-index texture
layout(binding = 0) uniform sampler2DArray uBaryTex;

// Triangle vertex index list
layout(std430, binding = 1) buffer VertexList {
    uint vertexList[];
};

// Output λ values
layout(std430, binding = 2) buffer LambdaOut {
    float lambda[];
};

// Output wsum per cubemap
layout(std430, binding = 3) buffer WSumOut {
    float wsum[];
};

layout(binding = 4) uniform sampler2DArray uSolidAngleTex;

// Push constants for parameters
layout(push_constant) uniform Params {
    int   uNumCubemaps;
    int   uNumCageVertices;
    ivec2 uFaceSize;
    int   uFacesPerCubemap;
    int   uNumTriangles; 
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint layer = gl_GlobalInvocationID.z;

    if (x >= params.uFaceSize.x || y >= params.uFaceSize.y)
        return;

    uint cubemapIdx = layer / params.uFacesPerCubemap;
    uint face = layer % params.uFacesPerCubemap;
    if (cubemapIdx >= uint(params.uNumCubemaps)) return;

    vec4 tex = texelFetch(uBaryTex, ivec3(x, y, layer), 0);

    uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);
    if (tri >= uint(params.uNumTriangles)) return;

    float w = texelFetch(uSolidAngleTex, ivec3(x, y, face), 0).r;

    uint base = cubemapIdx * uint(params.uNumCageVertices);

    uint i0 = vertexList[tri * 3 + 0];
    uint i1 = vertexList[tri * 3 + 1];
    uint i2 = vertexList[tri * 3 + 2];

    atomicAdd(lambda[base + i0], tex.r * w);
    atomicAdd(lambda[base + i1], tex.g * w);
    atomicAdd(lambda[base + i2], tex.b * w);
    atomicAdd(wsum[cubemapIdx], w);
}
