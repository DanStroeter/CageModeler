#version 450

// barycentric + tri-index texture
layout(binding = 0) uniform sampler2DArray uBaryTex;

// Triangle vertex index list
layout(std430, binding = 1) buffer VertexList {
    uint vertexList[];
};

// Output λ values
layout(std430, binding = 2) buffer LambdaOut {
    float lambda[];
};

// Output wsum per cubemap
layout(std430, binding = 3) buffer WSumOut {
    float wsum[];
};

// Push constants for parameters
layout(push_constant) uniform Params {
    int   uNumCubemaps;
    int   uNumCageVertices;
    ivec2 uFaceSize;
    int   uFacesPerCubemap;
    int   uNumTriangles; 
} params;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint cubemapIdx = gl_GlobalInvocationID.x;
    if (cubemapIdx >= uint(params.uNumCubemaps)) return;

    uint base = cubemapIdx * uint(params.uNumCageVertices);

    // Clear output range
    for (int i = 0; i < params.uNumCageVertices; ++i)
        lambda[base + uint(i)] = 0.0;

    float wsum_local = 0.0;

    int width  = params.uFaceSize.x;
    int height = params.uFaceSize.y;

    for (int face = 0; face < params.uFacesPerCubemap; ++face) {
        int layer = int(cubemapIdx) * params.uFacesPerCubemap + face;

        for (int y = 0; y < height; ++y) {
            for (int x = 0; x < width; ++x) {

                vec4 tex = texelFetch(uBaryTex, ivec3(x, y, layer), 0);
                float b0 = tex.r;
                float b1 = tex.g;
                float b2 = tex.b;

		uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);

                if (tri >= uint(params.uNumTriangles))
                  continue;

                uint i0 = vertexList[tri * 3u + 0u];
                uint i1 = vertexList[tri * 3u + 1u];
                uint i2 = vertexList[tri * 3u + 2u];

                float w = 1.0;

                if (i0 < uint(params.uNumCageVertices)) lambda[base + i0] += b0 * w;
                if (i1 < uint(params.uNumCageVertices)) lambda[base + i1] += b1 * w;
                if (i2 < uint(params.uNumCageVertices)) lambda[base + i2] += b2 * w;

                wsum_local += w;
            }
        }
    }

    wsum[cubemapIdx] = wsum_local;
}
