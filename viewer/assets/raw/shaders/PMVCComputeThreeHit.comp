#version 450
#extension GL_EXT_shader_atomic_float : require

// Three-hit PMVC variant.
//
// This compute shader combines the contributions of two rendered hits in a
// single dispatch. The first hit (set A) is weighted by uWeightA (alpha) and the
// second hit (set B) is weighted by uWeightB (beta, defaults to -1 so the second
// hit's contribution is subtracted). Both texture sets are sampled per ray so the
// per-pixel contributions can be added up before they are accumulated into the
// output buffers.
//
// The same shader is reused for the (optional) third hit by binding the third hit
// into set A weighted by theta and setting uWeightB to 0.

// Set A: first hit barycentric + triangle index image
layout(binding = 0) uniform sampler2DArray uBaryTexA;

// Triangle vertex index list (3 indices per triangle)
layout(std430, binding = 1) readonly buffer VertexList {
    uint vertexList[];
};

// Output λ values (one buffer per dispatch / cubemap)
layout(std430, binding = 2) buffer LambdaOut {
    float lambda[];
};

// Output wsum (single float per dispatch / cubemap)
layout(std430, binding = 3) buffer WSumOut {
    float wsum[];
};

// Solid angle lookup (per face, independent of which hit is sampled)
layout(binding = 4) uniform sampler2DArray uSolidAngleTex;

// Set A depth cubemap
layout(binding = 5) uniform sampler2DArray uDepthTexA;

// Set B: second hit barycentric + triangle index image
layout(binding = 6) uniform sampler2DArray uBaryTexB;

// Set B depth cubemap
layout(binding = 7) uniform sampler2DArray uDepthTexB;

// Push constants
layout(push_constant) uniform Params {
    ivec2 uFaceSize;       // cubemap face resolution
    int   uNumTriangles;   // number of triangles in cage mesh
    float uWeightA;        // weight for the first hit (alpha / theta)
    float uWeightB;        // weight for the second hit (beta)
} params;


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void accumulateHit(vec4 tex, float depth, float solidAngle, float weightScale)
{
    uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);
    if (tri >= uint(params.uNumTriangles))
        return;

    // 1.0 means no geometry hit (clear value).
    if (depth >= 0.999999)
        return;

    float depthWeight = 1.0 - depth;
    float w = solidAngle * depthWeight;
    if (w <= 0.0)
        return;

    // Apply the per-hit weight. weightScale can be negative (beta) to swap the
    // sign of the contribution, or 0 to disable the second set.
    w *= weightScale;
    if (w == 0.0)
        return;

    uint i0 = vertexList[tri * 3 + 0];
    uint i1 = vertexList[tri * 3 + 1];
    uint i2 = vertexList[tri * 3 + 2];

    atomicAdd(lambda[i0], tex.r * w);
    atomicAdd(lambda[i1], tex.g * w);
    atomicAdd(lambda[i2], tex.b * w);
    atomicAdd(wsum[0], w);
}

void main()
{
    uint x    = gl_GlobalInvocationID.x;
    uint y    = gl_GlobalInvocationID.y;
    uint face = gl_GlobalInvocationID.z;

    if (x >= uint(params.uFaceSize.x) ||
        y >= uint(params.uFaceSize.y) ||
        face >= 6u)
    {
        return;
    }

    float solidAngle = texelFetch(uSolidAngleTex, ivec3(x, y, face), 0).r;

    // First hit (set A), weighted by alpha (or theta for the third hit).
    vec4  texA   = texelFetch(uBaryTexA, ivec3(x, y, face), 0);
    float depthA = texelFetch(uDepthTexA, ivec3(x, y, face), 0).r;
    accumulateHit(texA, depthA, solidAngle, params.uWeightA);

    // Second hit (set B), weighted by beta. When uWeightB == 0 the second set is
    // skipped entirely (used for the single-texture third hit pass).
    if (params.uWeightB != 0.0)
    {
        vec4  texB   = texelFetch(uBaryTexB, ivec3(x, y, face), 0);
        float depthB = texelFetch(uDepthTexB, ivec3(x, y, face), 0).r;
        accumulateHit(texB, depthB, solidAngle, params.uWeightB);
    }
}
