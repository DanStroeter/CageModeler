#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 0, binding = 1, std430) buffer DebugBuffer
{
    uint values[];
} debugBuffer;

layout(location = 0) rayPayloadEXT uint payload;

void main()
{
    uint rayIndex = gl_LaunchIDEXT.x;

    vec3 origin = vec3(0.0, 100.0, 0.0);   // Shoot from above
    vec3 dir    = vec3(0.0, -1.0, 0.0);    // Straight down

    payload = 0xDEADBEEFu;  // Initial marker

    traceRayEXT(
        tlas,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,   // sbtRecordOffset
        0,   // sbtRecordStride
        0,   // missIndex
        origin,
        0.001,
        dir,
        10000.0,
        0
    );

    // Store final payload result
    debugBuffer.values[rayIndex] = payload;
}